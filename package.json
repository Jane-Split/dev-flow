    "test:build": "node tests/build.test.js",
    "test:links": "node tests/links.test.js",
    "test:size": "node tests/size-warning.test.js",
    "test:format": "node tests/format.test.js",
    "build": "node scripts/build.cjs",
    "verify": "node scripts/build.cjs --verify",
    "version-check": "node scripts/version-check.js"
  },
  "keywords": [
    "ai",
