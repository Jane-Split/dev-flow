{
  "name": "dev-flow",
  "version": "3.6.0",
  "description": "AI开发全流程自动化Agent技能系统",
  "type": "module",
  "main": "scripts/install.js",
  "bin": {
    "dev-flow": "scripts/install.js"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "prepublishOnly": "node scripts/install.js",
    "test": "node scripts/version-check.js && node tests/run-all.js",
